# Doxygen configuration of the accelerometer calibration firmware. Shared settings
# are in ../Doxyfile.base; the start page is README.md. Run "doxygen" in this
# folder; the HTML goes to docs/html/index.html.
#
# Only the code we write is documented: Application/ (the application and the
# libraries). Core/ and Drivers/ are generated by STM32CubeMX and left out.

@INCLUDE               = ../Doxyfile.base

PROJECT_NAME           = "Accel_Calib_stm32"
PROJECT_NUMBER         = v1.0
PROJECT_BRIEF          = "Accelerometer calibration firmware: NUCLEO-WL55JC1, ADXL355 or ADXL345 on SPI1"

# Start page, the README of every folder (so the links between them work), and
# the code. RECURSIVE (from the base) walks the Inc/, Src/ and stm32wl/ folders.
INPUT                  = README.md \
                         docs/README.md \
                         docs/diagrams/README.md \
                         docs/diagrams/slides/README.md \
                         Application

