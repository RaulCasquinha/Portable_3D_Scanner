# Software architecture of the firmware (Accel_Calib_stm32).
# Render: bash docs/diagrams/compile.sh (writes out/architecture.svg and .png)
#
# Every module belongs to one layer and uses only the layers below it.
# Arrows point from the user of a module to the module it uses.

direction: down

title: |md
  # Accel_Calib_stm32: firmware architecture
  The board only captures: the PC fits. Each layer uses only the layers below it.
| {near: top-center}

classes: {
  layer: {
    style: {border-radius: 8; stroke-width: 2; font-size: 22; bold: true}
  }
  module: {
    shape: rectangle
    style: {border-radius: 4; font-size: 15}
  }
  external: {
    shape: cylinder
    style: {font-size: 15; fill: "#F4F4F4"}
  }
}

core: "Core/ (generated by STM32CubeMX)" {
  class: layer
  style.fill: "#F4F4F4"
  main: "main.c\nclocks, GPIO, SPI1, COM1;\nAPP_Init(), APP_Run()" {class: module}
}

app: "App/: the application (library APP)" {
  class: layer
  style.fill: "#F3FAF3"
  app_c: "app.c\nAPP_Run(): main loop, commands,\nstream; runs the capture" {class: module}
  conf: "app_calib_conf.h\nsettings, calibration constants" {class: module}
  app_c -> conf
}

services: "App/: services" {
  class: layer
  style.fill: "#FDF8EE"
  accel: "app_accel.c\nthe sensor: read g, temperature" {class: module}
  protocol: "app_protocol.c\nlines <-> commands and events" {class: module}
  log: "app_log.c\nLOG(): debug text, Debug builds only" {class: module}
}

transport: "App/: transport" {
  class: layer
  style.fill: "#FFF1EE"
  com_link: "app_link.c\nCOM1: send text, receive bytes,\nwith timeouts" {class: module}
}

libraries: "Libraries (no HAL, no App/: platform services injected)" {
  class: layer
  style.fill: "#EEF2FF"
  accel_calib: "AccelCalib/accel_calib.c\nguided capture: stillness, new\norientation, references -> events;\nACCEL_CALIB_Apply()" {class: module}
  adxl355: "ADXL355/\ndriver + stm32wl platform" {class: module}
  adxl345: "ADXL345/\ndriver + stm32wl platform" {class: module}
}

hal: "Drivers/ (ST HAL, BSP, CMSIS)" {
  class: layer
  style.fill: "#F4F4F4"
  stm32_hal: "HAL: UART, SPI, GPIO, tick" {class: module}
}

sensor: "ADXL355 or ADXL345\n(SPI1)" {class: external}
pc: "PC app\nAccel_Calib_App\n(ST-LINK VCOM 115200)" {class: external}

core.main -> app.app_c
app.app_c -> services.accel
app.app_c -> services.protocol
app.app_c -> services.log
app.app_c -> libraries.accel_calib: "runs the capture,\ngets its events"
services.protocol -> transport.com_link
services.protocol -> libraries.accel_calib: "event types"
services.accel -> libraries.adxl355: "APP_SENSOR"
services.accel -> libraries.adxl345
services.accel -> hal.stm32_hal: "SPI mode"
transport.com_link -> hal.stm32_hal
libraries.adxl355 -> hal.stm32_hal: "stm32wl/ only"
libraries.adxl345 -> hal.stm32_hal: "stm32wl/ only"
hal.stm32_hal -> sensor
hal.stm32_hal -> pc: "UART"
