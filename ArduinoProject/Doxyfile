#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "TFM - Portable 3D Scanner"
PROJECT_BRIEF          = "ESP32-S3 handheld 3D scanner firmware"
PROJECT_NUMBER         = 1.0

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = .
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.ino *.md
EXTENSION_MAPPING      = ino=C++
EXCLUDE_PATTERNS       = */doxy_docs/*

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
OUTPUT_DIRECTORY       = doxy_docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES

#---------------------------------------------------------------------------
# Graphs (requires Graphviz; gracefully skipped if not installed)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
